# Leave empty in development: Vite proxies /api to the backend (see vite.config.ts).
# Set to the API's origin when the frontend is served separately, e.g. https://api.example.com
VITE_API_URL=

# Where the dev-server proxy sends /api requests (default http://localhost:4000).
# VITE_PROXY_TARGET=http://localhost:4000
